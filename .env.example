APP_NAME=Oftob_Sohtumon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Адрес программы в интернете (на хостинге — https://ваш-домен.uz). От него строятся ссылки для Meta и телефонов сотрудников.
APP_URL=http://localhost:8000
# Первый запуск /setup с другого компьютера: откройте https://ваш-сайт/setup?key=ЭТОТ_КЛЮЧ (или создайте владельца: php artisan oftob:user email пароль --role=superadmin)
SETUP_KEY=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# По умолчанию — SQLite (файл database/database.sqlite). Для MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=oftob
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Версия Graph API для Facebook / Instagram / WhatsApp
META_GRAPH_VERSION=v23.0
